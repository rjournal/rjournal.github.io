%%%%% result tables
\newcommand{\tbCompare}{
\begin{table}[htp!]
	\centering
	\caption{Comparison of implementation optimizations between \hhmc and \zhmc}
	\label{tab:implementation-comparison}
	\begin{tabular}{p{4cm} p{3.5cm} p{3.5cm}}
		\toprule
		\textbf{Optimization} & \textbf{\hhmc} & \textbf{\zhmc} \\
		\midrule
		\textbf{Language} & C++ via Rcpp & C++ via Rcpp \\
		\textbf{Linear algebra} & Eigen library & Eigen library \\
		\textbf{RNG\textsuperscript{1}} & \texttt{std::mt19937} & \texttt{std::mt19937} \\
		\textbf{SIMD\textsuperscript{2}} & No & Yes (SSE/AVX) \\
		\textbf{Memory optimization} & Standard Eigen & Aligned allocation  \\
		\bottomrule
	\end{tabular}
	\vspace{2mm}
	\footnotesize
	\begin{tabular}{@{}p{12cm}@{}}
		\textsuperscript{1}RNG: random number generator. 
		\textsuperscript{2}SIMD: single instruction multiple data.
	\end{tabular}
\end{table}
}
\newcommand\tbAll{
	\begin{table}[htp!]
		\caption{Efficiency comparison of \hhmc, \zhmc, \zhmc with NUTS (Zigzag-NUTS), and \mt sampling approaches across three example correlation structures. 
		We report $\timeFirstSample$, $\timeHundredSamples$, and $\timeKiloSamples$ (in seconds) — the run-times to obtain 1, 100, and 1000 effective samples, respectively. 
		LKJ and HIV cases where \mt takes more than two hours to generate 100 samples are omitted.
		We benchmark each test for three replications using \CRANpkg{rbenchmark} \citep{rbenchmark} and report the average run-time. 
		Bold numbers are column minimums in each test.}  \label{tb:All}
		\centering
		\resizebox{\columnwidth}{!}{
		\begin{tabular}{clrrrrrrrrrrr}
			\toprule
			\multicolumn{2}{l}{} & \multicolumn{3}{c}{$\dimd=100$} & \multicolumn{3}{c}{400} & \multicolumn{3}{c}{1600} \\
			\cmidrule(l{2pt}r{2pt}){3-11}
			& & $\timeFirstSample$ & $\timeHundredSamples$ & $\timeKiloSamples$ &
			$\timeFirstSample$ & $\timeHundredSamples$ & $\timeKiloSamples$ &
			$\timeFirstSample$ & $\timeHundredSamples$ & $\timeKiloSamples$ & \\
			\cmidrule(l{2pt}r{2pt}){1-11}
			\parbox[t]{2mm}{\multirow{4}{*}{\rotatebox[origin=c]{90}{LKJ}}}
			
			& \hhmc & \textbf{0.004} & \textbf{0.21} & \textbf{2.1} & \textbf{0.11} & 11 & 107 & \textbf{8.0} & 962 & 9680 \\ 
			& \zhmc & 0.017 & 0.66 & 6.6 & 0.27 & \textbf{9.3} & \textbf{92} & 9.9 & \textbf{805} & \textbf{8015} \\ 
			& \znuts & 0.014 & 0.60 & 6.1 & 0.29 & 10 & 102 & 13 & 1094 & 10891 \\ 
			& \mt & 1.9 & 19 & 101 & -- & -- & -- & -- & -- & -- \\ 
			
			\cmidrule(l{2pt}r{2pt}){1-11}
			\parbox[t]{2mm}{\multirow{4}{*}{\rotatebox[origin=c]{90}{CS$_{0.9}$}}}
			
			& \hhmc & $\mathbf{<0.001}$ & \textbf{0.014} & \textbf{0.15} & \textbf{0.007} & \textbf{0.086} & \textbf{0.83} & \textbf{0.42} & \textbf{2.9} & \textbf{25} \\ 
			& \zhmc & 0.006 & 0.39 & 3.9 & 0.21 & 18 & 180 & 6.3 & 535 & 5317 \\ 
			& \znuts & 0.013 & 1.1 & 12 & 1.0 & 102 & 1014 & 13 & 1062 & 10610 \\ 
			& \mt & 0.087 & 0.12 & 0.33 & 4.4 & 4.9 & 7.2 & 272 & 275 & 313 \\ 
			
			\cmidrule(l{2pt}r{2pt}){1-11}
			\parbox[t]{2mm}{\multirow{4}{*}{\rotatebox[origin=c]{90}{HIV}}}
			
			& \hhmc & \textbf{0.003} & 0.32 & 3.4 & 0.17 & 14 & 138 & 10.7 & 1068 & 10968 \\ 
			& \zhmc & 0.009 & 0.35 & 3.4 & \textbf{0.14} & 7.1 & 71 & \textbf{2.8} & \textbf{148} & \textbf{1480} \\ 
			& \znuts & 0.013 & 0.66 & 6.5 & 0.17 & 11 & 109 & 4.3 & 218 & 2261 \\ 
			& \mt & 0.040 & \textbf{0.056} & \textbf{0.19} & 2.3 & \textbf{2.7} & \textbf{5.1} & -- & -- & -- \\ 
			\bottomrule
			\multicolumn{11}{l}{\footnotesize Dashes (--) indicate the method required \>2 hours for 100 samples.}\\
		\end{tabular}
		}
	\end{table}
}

